# Copy to .env and adjust.
PORT=4000
NODE_ENV=development

# SQLite file (relative to backend/)
DATABASE_PATH=./data/lab.db

# How long a login lasts
SESSION_TTL_HOURS=168

# Set to 1 when running behind a reverse proxy (nginx, Caddy, etc.)
TRUST_PROXY=0

# Used by `npm run seed` to create the first admin account
ADMIN_EMAIL=admin@example.edu
ADMIN_NAME=Lab Admin
ADMIN_PASSWORD=change-me-please

# Sign in with GitHub (optional). Members of GITHUB_ORG can sign in (org owners
# as admins), plus any accounts listed by id below. With neither set, GitHub
# sign-in is off.
#
# Create an OAuth app at https://github.com/settings/developers with the
# callback URL <SITE_URL>/api/auth/github/callback.
SITE_URL=http://localhost:5180
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub organization (e.g. S-H-E-R-P-AI-Lab). Members can sign in; leaving the
# org ends access within 10 minutes.
GITHUB_ORG=

# Extra accounts outside the org, as comma-separated *numeric* GitHub account
# ids (not usernames, which can be renamed and reclaimed). Find one at
# https://api.github.com/users/<username> under "id". Admins can also delete
# content. Changes apply on restart, and removed accounts are signed out on
# their next request.
GITHUB_MEMBER_IDS=
GITHUB_ADMIN_IDS=

# Integrations for the intranet (not used by the code yet; production values
# live on Railway, see README "Integrations"). All optional locally.
#
# GitHub App "SHERP Lab Intranet", installed on the S-H-E-R-P-AI-Lab org.
# Private key: base64 of the .pem.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
# Slack app "SHERP Lab Website" in the PicarX Research workspace.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Google service account (base64 of its JSON key) and the Drive folder shared with it.
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_FOLDER_ID=
